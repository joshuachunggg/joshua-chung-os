# Copy to .env.local and fill in what you need.
# Every one of these is optional — the desktop boots fine without them.

# Contact form (https://resend.com) — the Contact app emails you via this
RESEND_API_KEY=
# Where contact-form mail is delivered
CONTACT_TO=you@example.com

# Text-to-speech proxy at /api/tts (https://elevenlabs.io)
ELEVENLABS_API_KEY=

# Calendar app booking embed (e.g. a Cal.com instance)
NEXT_PUBLIC_CAL_URL=https://cal.com
NEXT_PUBLIC_CAL_USERNAME=your-username
